# ==============================================================================
# Backend Challenge Go — Environment Configuration
# ==============================================================================

# Application & HTTP Server
APP_ENV=local
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL 16 Persistence
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wager_db
DB_SSLMODE=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=5

# AWS LocalStack SQS
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Keycloak OAuth 2.0 / OIDC (Port 8082 to avoid collision with app HTTP_PORT 8080)
KEYCLOAK_BASE_URL=http://localhost:8082
KEYCLOAK_REALM=wager-realm
KEYCLOAK_JWKS_URL=http://localhost:8082/realms/wager-realm/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8082/realms/wager-realm

# Workers Configuration
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
PENDING_REF_POLL_INTERVAL=1s
PENDING_REF_MAX_RETRIES=5
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_WAIT_TIME_SECONDS=10
